#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};


/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings = 
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp E>,
                <&macro_release &kp CAPSLOCK>;
        };
    };

    behaviors {
        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };
    };


    /* Geonix Compact5 combos. Indices reflect 10+10+10+12 LisM bindings.
       Each combo is layer-scoped to avoid triggering during device/mouse use. */
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <60>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
            layers = <0>;
        };
        combo_tab {
            timeout-ms = <60>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
            layers = <0>;
        };
        combo_eisu {
            timeout-ms = <60>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
            layers = <0>;
        };
        combo_kana {
            timeout-ms = <60>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
            layers = <0>;
        };
        combo_at_jis {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&kp LEFT_BRACKET>;
            layers = <0>;
        };
        combo_long_vowel {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp MINUS>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Geonix Base";
            bindings = <
                &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &kp Y                 &kp U                 &kp I                 &kp O                 &lt 3 P
                &kp A                 &kp S                 &kp D                 &kp F                 &kp G                 &kp H                 &kp J                 &kp K                 &kp L                 &kp SEMICOLON
                &mt LSHIFT Z          &kp X                 &kp C                 &kp V                 &kp B                 &kp N                 &kp M                 &kp COMMA             &kp DOT               &mt RSHIFT SINGLE_QUOTE
                &kp LCTRL             &kp LGUI              &kp LALT              &msc SCRL_UP          &lt 1 DELETE          &kp SPACE             &lt 4 ENTER           &lt 2 BACKSPACE       &msc SCRL_UP          &kp RSHIFT            &kp INT1              &mt RCTRL SLASH
                &msc SCRL_LEFT        &msc SCRL_DOWN        &msc SCRL_RIGHT       &msc SCRL_LEFT        &msc SCRL_DOWN        &msc SCRL_RIGHT
            >;
            sensor-bindings = <&rsr_scrl &rsr_scrl>;
        };

        layer_1 {
            display-name = "Number/Symbol";
            bindings = <
                &kp NUMBER_1          &kp NUMBER_2          &kp NUMBER_3          &kp NUMBER_4          &kp NUMBER_5          &kp NUMBER_6          &kp NUMBER_7          &kp NUMBER_8          &kp NUMBER_9          &kp SLASH
                &kp TAB               &trans                &trans                &trans                &kp LS(MINUS)         &kp SINGLE_QUOTE      &kp NUMBER_4          &kp NUMBER_5          &kp NUMBER_6          &kp ASTERISK
                &kp LSHIFT            &trans                &trans                &trans                &kp INT3              &kp COMMA             &kp NUMBER_1          &kp NUMBER_2          &kp NUMBER_3          &kp MINUS
                &mt LCTRL ESC         &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &kp NUMBER_0          &kp DOT               &kp PLUS
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            display-name = "Function";
            bindings = <
                &kp F1                &kp F2                &kp F3                &kp F4                &kp F5                &kp F6                &kp F7                &kp F8                &kp F9                &kp F10
                &kp TAB               &trans                &trans                &trans                &trans                &kp LEFT              &kp UP                &kp DOWN              &kp RIGHT             &kp F11
                &kp LSHIFT            &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &mt LCTRL ESC         &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };

        layer_3 {
            display-name = "Device";
            bindings = <
                &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4          &bt BT_CLR            &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &sys_reset            &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &sys_reset
                &bootloader           &bt BT_CLR_ALL        &trans                &trans                &trans                &trans                &studio_unlock        &trans                &trans                &trans                &trans                &bootloader
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };

        layer_4 {
            display-name = "Mouse";
            bindings = <
                &trans                &trans                &mmv MOVE_UP          &trans                &trans                &trans                &trans                &msc SCRL_UP          &trans                &trans
                &trans                &mmv MOVE_LEFT        &mmv MOVE_DOWN        &mmv MOVE_RIGHT       &trans                &trans                &mkp MB1              &mkp MB3              &mkp MB2              &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &msc SCRL_DOWN        &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };

        layer_5 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
                                                    &trans                &trans                  &trans                                                 &trans       &trans           &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
                                                    &trans                &trans                  &trans                                                 &trans       &trans           &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
                                                    &trans                &trans                  &trans                                                 &trans       &trans           &trans
            >;
        };
    };

};