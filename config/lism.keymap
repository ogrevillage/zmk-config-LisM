#define ZMK_POINTING_DEFAULT_SCRL_VAL 100 // Keep existing scroll defaults for the encoder and other bindings
// Left 4-way stick L0: use MOVE_X/Y(20) for slower continuous scroll, independently of the 100 default.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/modifiers.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};


/ {
    macros {

        paren_pair: paren_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp LS(NUMBER_8) &kp LS(NUMBER_9) &kp LEFT_ARROW>;
        };
        bracket_pair: bracket_pair {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp RIGHT_BRACKET &kp NUHS &kp LEFT_ARROW>;
        };
        // IME macros return to BASE only when triggered from AUTO MOUSE.
        ime_eisu_base: ime_eisu_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LANG2 &to 0>;
        };
        ime_kana_base: ime_kana_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LANG1 &to 0>;
        };
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings = 
                <&macro_press &kp CAPSLOCK>,
                <&macro_tap &kp E>,
                <&macro_release &kp CAPSLOCK>;
        };
    };

    behaviors {
        // L0 A: Left Alt + A acts as Alt+Tab, but any other held modifier
        // (Ctrl, Shift, Win, right Alt) keeps the original A key.
        alt_a_tab: alt_a_tab {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp A>, <&kp TAB>;
            mods = <MOD_LALT>;
            keep-mods = <MOD_LALT>;
        };

        alt_only_a: alt_only_a {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&alt_a_tab>, <&kp A>;
            mods = <(MOD_LCTL | MOD_RCTL | MOD_LSFT | MOD_RSFT | MOD_LGUI | MOD_RGUI | MOD_RALT)>;
            keep-mods = <(MOD_LCTL | MOD_RCTL | MOD_LSFT | MOD_RSFT | MOD_LGUI | MOD_RGUI | MOD_RALT)>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_UP>; // Reverse hardware-reported direction: physical CW should scroll down
            ccw-binding = <&msc SCRL_DOWN>; // Physical CCW should scroll up
        };
    };

    // Physical positions 0-29 match KobitoKey_DYA. Layer 3 is auto mouse.
    combos {
        compatible = "zmk,combos";
        // IME switching keeps the current number layer; only AUTO MOUSE returns to BASE.
        combo_eisu { timeout-ms = <50>; key-positions = <11 13>; bindings = <&kp LANG2>; layers = <0 1 5>; }; // S+F, BASE/NUMBER/NUMBER2
        combo_kana { timeout-ms = <50>; key-positions = <16 18>; bindings = <&kp LANG1>; layers = <0 1 5>; }; // J+L, BASE/NUMBER/NUMBER2
        combo_eisu_mouse { timeout-ms = <50>; key-positions = <11 13>; bindings = <&ime_eisu_base>; layers = <3>; }; // S+F, AUTO MOUSE -> BASE
        combo_kana_mouse { timeout-ms = <50>; key-positions = <16 18>; bindings = <&ime_kana_base>; layers = <3>; }; // J+L, AUTO MOUSE -> BASE
        combo_esc { timeout-ms = <50>; key-positions = <0 1>; bindings = <&kp ESC>; layers = <0>; };
        combo_tab { timeout-ms = <50>; key-positions = <10 11>; bindings = <&kp TAB>; layers = <0>; };
        combo_long_vowel { timeout-ms = <50>; key-positions = <8 9>; bindings = <&kp MINUS>; layers = <0 1 5>; };
        combo_at { timeout-ms = <50>; key-positions = <13 16>; bindings = <&kp LEFT_BRACKET>; layers = <0>; };
        combo_paren_pair { timeout-ms = <50>; key-positions = <18 19>; bindings = <&paren_pair>; layers = <0 1 5>; };
        combo_bracket_pair { timeout-ms = <50>; key-positions = <28 29>; bindings = <&bracket_pair>; layers = <0 1 5>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "L0 BASE";
            bindings = <
                &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &kp Y                 &kp U                 &kp I                 &kp O                 &lt 4 P
                &alt_only_a           &kp S                 &kp D                 &kp F                 &kp G                 &kp H                 &kp J                 &kp K                 &kp L                 &kp SEMI
                &mt LSHIFT Z          &kp X                 &kp C                 &kp V                 &kp B                 &kp N                 &kp M                 &kp COMMA             &kp DOT               &mt RSHIFT APOS
                &mt LCTRL ESCAPE      &kp LWIN              &kp LALT              &msc MOVE_Y(20)       &lt 5 DEL             &kp SPACE             &kp ENTER             &lt 2 BACKSPACE       &msc SCRL_UP          &none                 &mt RGUI INT1         &mt RCTRL SLASH
                &msc MOVE_X(-20)      &msc MOVE_Y(-20)      &msc MOVE_X(20)       &msc SCRL_LEFT        &msc SCRL_DOWN        &msc SCRL_RIGHT
            >;
            sensor-bindings = <&rsr_scrl &rsr_scrl>;
        };

        layer_1 {
            display-name = "L1 NUMBER";
            bindings = <
                &kp LEFT_BRACKET      &kp NUMBER_7          &kp NUMBER_8          &kp NUMBER_9          &trans                &kp KP_MINUS          &trans                &kp UP_ARROW          &trans                &kp LEFT_BRACKET
                &kp INT3              &kp NUMBER_4          &kp NUMBER_5          &kp NUMBER_6          &kp LS(MINUS)         &kp KP_PLUS           &kp LEFT_ARROW        &kp DOWN_ARROW        &kp RIGHT_ARROW       &trans
                &kp NUMBER_0          &kp NUMBER_1          &kp NUMBER_2          &kp NUMBER_3          &kp PERIOD            &kp KP_MULTIPLY       &kp KP_SLASH          &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            display-name = "L2 FUNCTION";
            bindings = <
                &kp F1                &kp F2                &kp F3                &kp F4                &kp F5                &kp F6                &kp F7                &kp F8                &kp F9                &kp F10
                &kp TAB               &kp LG(LS(LEFT_ARROW)) &kp LG(UP_ARROW)     &kp LG(LS(RIGHT_ARROW)) &trans             &trans                &kp LEFT_ARROW        &kp UP_ARROW          &kp RIGHT_ARROW       &kp F11
                &kp LEFT_SHIFT        &trans                &kp LG(DOWN_ARROW)   &trans                &trans                &trans                &trans                &kp DOWN_ARROW        &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };

        layer_3 {
            display-name = "L3 AUTO MOUSE";
            // I / comma: vertical wheel up/down for Ctrl+wheel zoom, fine step 10.
            bindings = <
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &msc MOVE_Y(10)                &trans                &trans
                &kp A                 &trans                &trans                &trans                &trans                &trans                &mkp MB1              &mkp MB3              &mkp MB2              &trans
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &msc MOVE_Y(-10)                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &to 0                 &trans                &trans                &trans                &trans                &to 0                 &trans
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };

        layer_4 {
            display-name = "L4 BT/DEVICE";
            bindings = <
                &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4          &trans                &trans                &trans                &trans                &trans
                &kp A                 &trans                &bt BT_PRV            &bt BT_NXT            &trans                &trans                &trans                &trans                &trans                &trans
                &trans            &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                &bootloader           &bt BT_CLR_ALL        &trans                &trans                &trans                &trans                &studio_unlock        &trans                &trans                &trans                &trans                &trans
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };

        layer_5 {
            display-name = "L5 NUMBER2";
            bindings = <
                &kp N1                &kp N2                &kp N3                &kp N4                &kp N5                &kp N6                &kp N7                &kp N8                &kp N9                &kp KP_SLASH
                &kp TAB               &trans                &trans                &trans                &kp LS(MINUS)         &kp APOS              &kp N4                &kp N5                &kp N6                &kp KP_MULTIPLY
                &kp LEFT_SHIFT        &trans                &trans                &trans                &kp INT3              &kp N0                &kp N1                &kp N2                &kp N3                &kp KP_MINUS
                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &none                 &kp PERIOD            &kp KP_PLUS
                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };

        layer_6 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
                                                    &trans                &trans                  &trans                                                 &trans       &trans           &trans
            >;
        };

        layer_7 {
            status = "reserved";
            display-name = "Brank Layer";
            bindings = <
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans                                                 &trans       &trans           &trans             &trans              &trans
                &trans           &trans             &trans                &trans                  &trans            &trans              &trans           &trans       &trans           &trans             &trans              &trans
                                                    &trans                &trans                  &trans                                                 &trans       &trans           &trans
            >;
        };
    };

};